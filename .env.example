# Private server-side model configuration. Copy to .env and run chmod 600 .env.
# File selection: --env-file > CAMP_ENV_FILE > ./.env. The default may be absent.
# Nonempty process environment > selected file > Camp managed settings > defaults. No Shell expansion.
# Only these keys are loaded. Values never enter frontend configuration.
DEEPSEEK_API_KEY=
# Official defaults: https://api.deepseek.com/anthropic, deepseek-v4-pro.
DEEPSEEK_BASE_URL=
CAMP_DSH_MODEL=
# Defaults: 4096 output tokens per request, 8 observed steps, 180 seconds per run.
# Configuration limits: 8192 output tokens per request, 32 steps, 900 seconds.
CAMP_DSH_MAX_TOKENS=
CAMP_DSH_MAX_STEPS=
CAMP_DSH_TIMEOUT_SECONDS=

# Native execution paths belong to Runner setup, not Server model settings.
# Source document readers use process-only CAMP_DOCUMENT_NODE and CAMP_DOCUMENT_RUNTIME.
# Process-only (not loaded here): CAMP_PUBLIC_ORIGIN,
# CAMP_DOCUMENT_RUNTIME, CAMP_DOCUMENT_NODE and CAMP_IMPORT_ROOTS.
